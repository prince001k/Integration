# Local PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:Prince@123@localhost:5432/instagram_chat

# Instagram / Meta Access Token (from your Meta App Dashboard)
META_ACCESS_TOKEN=your_instagram_access_token_here

# Instagram Webhook Verify Token (must match what you set in Meta App Dashboard)
VERIFY_TOKEN=instagram_verify_123

# Server port (optional, defaults to 5000)
PORT=5000
